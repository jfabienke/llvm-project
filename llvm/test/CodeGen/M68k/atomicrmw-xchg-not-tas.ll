; CRITICAL REGRESSION GUARD:
; This test ensures atomicrmw xchg NEVER lowers to TAS instruction.
;
; WHY: TAS is "Test-and-Set-Bit-7", NOT atomic swap.
;   - TAS: Reads byte, sets bit 7, writes back (bits 6-0 untouched)
;   - SWAP: Reads byte, writes NEW ARBITRARY VALUE, returns old value
;   - Lowering swap to TAS would corrupt data!
;
; CORRECT BEHAVIOR:
;   - MC68020/030/040: Should use CAS-loop or libcall
;   - MC68000/010/060: Should use libcall
;   - ALL CPUs: MUST NEVER emit "tas.b"

define i8 @swap_i8(i8* %p, i8 %v) nounwind {
; M68000-LABEL: swap_i8:
; M68000-NOT: tas.b
; M68000:       jsr
; M68000-SAME:  {{(__sync_lock_test_and_set_1|__atomic_exchange_1)}}
; M68000:       rts
;
; M68010-LABEL: swap_i8:
; M68010-NOT: tas.b
; M68010:       jsr
; M68010-SAME:  {{(__sync_lock_test_and_set_1|__atomic_exchange_1)}}
; M68010:       rts
;
; M68020-LABEL: swap_i8:
; M68020-NOT: tas.b
; M68020:       rts
;
; M68030-LABEL: swap_i8:
; M68030-NOT: tas.b
; M68030:       rts
;
; M68040-LABEL: swap_i8:
; M68040-NOT: tas.b
; M68040:       rts
;
; M68060-LABEL: swap_i8:
; M68060-NOT: tas.b
; M68060:       jsr
; M68060-SAME:  {{(__sync_lock_test_and_set_1|__atomic_exchange_1)}}
; M68060:       rts
entry:
  %old = atomicrmw xchg i8* %p, i8 %v monotonic
  ret i8 %old
}

; Additional test: Ensure swap with specific value (e.g., 5) doesn't become TAS
