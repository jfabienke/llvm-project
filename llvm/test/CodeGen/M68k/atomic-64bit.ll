; Test 64-bit atomic compare-and-swap lowering on M68k.
; All CPU variants should generate libcalls (__sync_* or __atomic_*).
; CAS2 instruction is NOT implemented in this backend.
; MC68020/030/040 have CAS2 in hardware, but it is not emitted by LLVM.
; MC68060 removed CAS2 from hardware (would trap if emitted).

; Verify we get a libcall and NOT a cas2 instruction
; LIBCALL-NOT: cas2
; LIBCALL:     jsr
; LIBCALL-SAME: {{(__sync_val_compare_and_swap_8|__atomic_compare_exchange_8)}}

; Optional prototypes (not required for matching, but harmless if left)
declare i64 @__sync_val_compare_and_swap_8(i64*, i64, i64)
declare i1  @__atomic_compare_exchange_8(i64*, i64* nocapture, i64, i32, i32, i32)

; Function: 64-bit compare-and-swap
; Returns the observed old value (standard cmpxchg lowering).
define i64 @cas64(i64* %p, i64 %expected, i64 %desired) nounwind {
entry:
  %pair = cmpxchg i64* %p, i64 %expected, i64 %desired monotonic monotonic
  %old  = extractvalue { i64, i1 } %pair, 0
  ret i64 %old
}

; A second function ensures multiple call sites are still handled via libcalls.
define i64 @cas64_again(i64* %p, i64 %expected, i64 %desired) nounwind {
entry:
  %pair = cmpxchg i64* %p, i64 %expected, i64 %desired monotonic monotonic
  %old  = extractvalue { i64, i1 } %pair, 0
  ret i64 %old
}
