; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc -mtriple=m68k-unknown-linux-gnu -mcpu=M68000 -O2 %s -o - | FileCheck %s --check-prefix=LIBCALL
; RUN: llc -mtriple=m68k-unknown-linux-gnu -mcpu=M68010 -O2 %s -o - | FileCheck %s --check-prefix=LIBCALL
; RUN: llc -mtriple=m68k-unknown-linux-gnu -mcpu=M68020 -O2 %s -o - | FileCheck %s --check-prefix=HWCAS
; RUN: llc -mtriple=m68k-unknown-linux-gnu -mcpu=M68030 -O2 %s -o - | FileCheck %s --check-prefix=HWCAS
; RUN: llc -mtriple=m68k-unknown-linux-gnu -mcpu=M68040 -O2 %s -o - | FileCheck %s --check-prefix=HWCAS
; RUN: llc -mtriple=m68k-unknown-linux-gnu -mcpu=M68060 -O2 %s -o - | FileCheck %s --check-prefix=LIBCALL

; This test validates the MC68060 CAS removal fix (FeatureHardwareCAS):
; - MC68000/010: No CAS hardware → libcall fallback
; - MC68020/030/040: Hardware CAS support → cas.b/w/l instructions
; - MC68060: CAS removed from hardware (Vector 61 trap) → libcall fallback
;
; The regex patterns accept both __sync_* (GCC) and __atomic_* (Clang) libcall naming.

; --------
; LIBCALL checks: accept either __sync_* or __atomic_* spellings
; --------
; LIBCALL-NOT: cas.
; LIBCALL:     jsr
; LIBCALL-SAME: {{(__sync_val_compare_and_swap_1|__atomic_compare_exchange_1)}}
; LIBCALL:     jsr
; LIBCALL-SAME: {{(__sync_val_compare_and_swap_2|__atomic_compare_exchange_2)}}
; LIBCALL:     jsr
; LIBCALL-SAME: {{(__sync_val_compare_and_swap_4|__atomic_compare_exchange_4)}}

; --------
; HWCAS checks: require hardware CAS instructions; ensure no libcall
; --------
; HWCAS:     cas.b
; HWCAS:     cas.w
; HWCAS:     cas.l
; HWCAS-NOT: jsr {{.*}}(__sync_val_compare_and_swap_|__atomic_compare_exchange_)

; --- Declarations for optional explicit __sync/__atomic prototypes (not strictly required)
declare i8  @__sync_val_compare_and_swap_1(i8*, i8, i8)
declare i16 @__sync_val_compare_and_swap_2(i16*, i16, i16)
declare i32 @__sync_val_compare_and_swap_4(i32*, i32, i32)
declare i1  @__atomic_compare_exchange_1(i8*, i8* nocapture, i8, i32, i32, i32)
declare i1  @__atomic_compare_exchange_2(i16*, i16* nocapture, i16, i32, i32, i32)
declare i1  @__atomic_compare_exchange_4(i32*, i32* nocapture, i32, i32, i32, i32)

; --- i8 CAS
define i8 @cas8(i8* %p, i8 %e, i8 %d) nounwind {
entry:
  %old = cmpxchg i8* %p, i8 %e, i8 %d monotonic monotonic
  %res = extractvalue { i8, i1 } %old, 0
  ret i8 %res
}

; --- i16 CAS
define i16 @cas16(i16* %p, i16 %e, i16 %d) nounwind {
entry:
  %old = cmpxchg i16* %p, i16 %e, i16 %d monotonic monotonic
  %res = extractvalue { i16, i1 } %old, 0
  ret i16 %res
}

; --- i32 CAS
define i32 @cas32(i32* %p, i32 %e, i32 %d) nounwind {
entry:
  %old = cmpxchg i32* %p, i32 %e, i32 %d monotonic monotonic
  %res = extractvalue { i32, i1 } %old, 0
  ret i32 %res
}
